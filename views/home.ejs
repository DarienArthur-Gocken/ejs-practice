<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice</title>
</head>
<body>
    <main>
        <header>
            <h1> EJS Practice</h1>
            <h2><%= person.name %></h2>
            <h3><%= person.occupation %></h3>

            <% if (person.occupation == 'plumber') { %>
                <p>You work with pipes!</p>
            <% } else { %>
                <p>That's an interesting job!</p>
            <% } %>
        </header>
    </main>
    
</body>
</html>